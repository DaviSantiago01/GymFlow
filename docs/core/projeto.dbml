Table ALU_ALUNO {
  ALU_ID bigint [pk, increment]
  ALU_USUARIO varchar(100) [not null, unique]
  ALU_NOME varchar(100) [not null]
  ACD_ID bigint [not null, default: 1, ref: > ACD_ACADEMIA.ACD_ID]
  indexes { (ALU_ID, ACD_ID) [unique] }
}
Table USU_CREDENCIAL {
  ALU_USUARIO varchar(100) [pk, ref: - ALU_ALUNO.ALU_USUARIO]
  USU_SENHA varchar(255) [not null, note: 'Hash compatível com DelegatingPasswordEncoder']
  USU_ATIVO boolean [not null, default: true]
}
Table ARM_ARMARIO {
  ARM_CODIGO varchar(5) [pk]
  ARM_LOCALIZACAO varchar(150) [not null]
  ARM_DESCRICAO varchar(250) [not null]
}
Table RSV_RESERVA_ARMARIO {
  RSV_ID bigint [pk, increment]
  ALU_ID bigint [not null, ref: > ALU_ALUNO.ALU_ID]
  ARM_CODIGO varchar(5) [not null, ref: > ARM_ARMARIO.ARM_CODIGO]
  RSV_CONFIRMACAO timestamptz [not null]
  RSV_INICIO timestamptz [not null, note: 'Início agendado, não anterior à confirmação']
  RSV_TERMINO timestamptz [not null, note: 'Início + 1, 2 ou 3 horas']
  RSV_ENCERRAMENTO timestamptz
  RSV_SITUACAO varchar(20) [not null, note: 'ATIVA, CANCELADA, ENCERRADA, VENCIDA']
  RSV_ALUNO_ATIVO bigint [unique, note: 'Gerada pelo H2: ALU_ID quando ATIVA, NULL nos demais estados']
  indexes {
    (RSV_SITUACAO, RSV_TERMINO)
    (ARM_CODIGO, RSV_SITUACAO, RSV_INICIO, RSV_TERMINO)
    (ALU_ID, RSV_CONFIRMACAO)
  }
}
Table PER_PERSONAL {
  PER_ID bigint [pk, increment]
  PER_USUARIO varchar(100) [not null, unique]
  PER_NOME varchar(100) [not null]
}
Table PCD_CREDENCIAL_PERSONAL {
  PER_ID bigint [pk, ref: - PER_PERSONAL.PER_ID]
  PCD_SENHA varchar(255) [not null, note: 'Hash compatível com DelegatingPasswordEncoder']
  PCD_ATIVO boolean [not null, default: true]
}
Table EXE_EXERCICIO {
  EXE_ID bigint [pk, increment]
  EXE_NOME varchar(100) [not null, unique]
  EXE_CATEGORIA varchar(20) [not null, note: 'PEITO, COSTAS, PERNAS, OMBROS, BRACOS, ABDOMEN']
  EXE_CARGA_MAXIMA decimal(7,2) [not null]
  EXE_INCREMENTO_CARGA decimal(7,2)
}
Table PLT_PLANO_TREINO {
  PLT_ID bigint [pk, increment]
  ALU_ID bigint [not null, ref: > ALU_ALUNO.ALU_ID]
  PER_ID bigint [not null, ref: > PER_PERSONAL.PER_ID]
  PLT_NOME varchar(100) [not null]
  PLT_FREQUENCIA_SEMANAL int [not null]
  PLT_SITUACAO varchar(20) [not null, note: 'RASCUNHO, ATIVO, ENCERRADO, SUBSTITUIDO']
  PLT_VERSAO int [not null]
  PLT_PLANO_ANTERIOR bigint [ref: > PLT_PLANO_TREINO.PLT_ID, note: 'Autorreferência: versão substituída por esta']
  PLT_CRIACAO timestamptz [not null]
  PLT_ENCERRAMENTO timestamptz
  PLT_ALUNO_ATIVO bigint [unique, note: 'Gerada pelo H2: ALU_ID quando ATIVO, NULL nos demais estados']
  indexes {
    (ALU_ID, PLT_CRIACAO)
  }
}
Table TRE_TREINO {
  TRE_ID bigint [pk, increment]
  PLT_ID bigint [not null, ref: > PLT_PLANO_TREINO.PLT_ID]
  TRE_INDICE int [not null, note: 'Posição do treino na lista do plano']
  TRE_NOME varchar(60) [not null]
  TRE_DIA varchar(10) [not null, note: 'SEGUNDA a DOMINGO']
  TRE_OBJETIVO varchar(20) [not null, note: 'FORCA, HIPERTROFIA, RESISTENCIA']
  indexes {
    (PLT_ID, TRE_DIA) [unique]
  }
}
Table SRE_SERIE {
  TRE_ID bigint [not null, ref: > TRE_TREINO.TRE_ID]
  SRE_INDICE int [not null, note: 'Posição da série na lista do treino']
  EXE_ID bigint [not null, ref: > EXE_EXERCICIO.EXE_ID]
  SRE_QUANTIDADE int [not null]
  SRE_REPETICOES_MINIMAS int [not null]
  SRE_REPETICOES_MAXIMAS int [not null]
  SRE_CARGA decimal(7,2) [not null]
  SRE_INTERVALO_SEGUNDOS int [not null]
  indexes {
    (TRE_ID, SRE_INDICE) [pk]
    (TRE_ID, EXE_ID) [unique]
  }
}
Table EXC_EXECUCAO_EXERCICIO {
  EXC_ID bigint [pk, increment]
  ALU_ID bigint [not null, ref: > ALU_ALUNO.ALU_ID]
  PLT_ID bigint [not null, ref: > PLT_PLANO_TREINO.PLT_ID]
  EXE_ID bigint [not null, ref: > EXE_EXERCICIO.EXE_ID]
  EXC_DIA varchar(10) [not null]
  EXC_DATA timestamptz [not null]
  EXC_SERIES int [not null]
  EXC_REPETICOES int [not null]
  EXC_CARGA decimal(7,2) [not null]
  indexes {
    (ALU_ID, EXE_ID, EXC_DATA)
  }
}
Table AVF_AVALIACAO_FISICA {
  AVF_ID bigint [pk, increment]
  ALU_ID bigint [not null, ref: > ALU_ALUNO.ALU_ID]
  PER_ID bigint [not null, ref: > PER_PERSONAL.PER_ID]
  AVF_DATA date [not null]
  AVF_PESO decimal(6,2) [not null]
  AVF_ALTURA decimal(6,2) [not null]
  AVF_IMC decimal(6,2) [not null]
  AVF_SITUACAO varchar(20) [not null, note: 'VALIDA, SUBSTITUIDA, EXCLUIDA']
  AVF_VERSAO int [not null]
  AVF_AVALIACAO_ANTERIOR bigint [ref: > AVF_AVALIACAO_FISICA.AVF_ID, note: 'Autorreferência: versão corrigida por esta']
  AVF_REGISTRO timestamptz [not null]
  AVF_ALUNO_VALIDA bigint [note: 'Gerada pelo H2: ALU_ID quando VALIDA, NULL nos demais estados']
  indexes {
    (AVF_ALUNO_VALIDA, AVF_DATA) [unique]
    (ALU_ID, AVF_DATA)
  }
}
Table MDC_MEDIDA_CORPORAL {
  AVF_ID bigint [not null, ref: > AVF_AVALIACAO_FISICA.AVF_ID]
  MDC_INDICE int [not null, note: 'Posição da medida na lista da avaliação']
  MDC_INDICADOR varchar(20) [not null]
  MDC_VALOR decimal(6,2) [not null]
  indexes {
    (AVF_ID, MDC_INDICE) [pk]
  }
}
Table MET_META {
  MET_ID bigint [pk, increment]
  ALU_ID bigint [not null, ref: > ALU_ALUNO.ALU_ID]
  PER_ID bigint [not null, ref: > PER_PERSONAL.PER_ID]
  MET_INDICADOR varchar(20) [not null]
  MET_VALOR_INICIAL decimal(6,2) [not null]
  MET_VALOR_DESEJADO decimal(6,2) [not null]
  MET_INICIO date [not null]
  MET_FIM date [not null]
  AVF_ID bigint [not null, ref: > AVF_AVALIACAO_FISICA.AVF_ID]
  MET_SITUACAO varchar(20) [not null, note: 'ATIVA, ATINGIDA, ENCERRADA, SUBSTITUIDA']
  MET_DATA_ATINGIDA date
  indexes {
    (ALU_ID, MET_INDICADOR, MET_SITUACAO)
  }
}

Table PRO_PROFESSOR {
  PRO_ID bigint [pk, increment]
  PRO_NOME varchar(100) [not null]
  PRO_ESPECIALIDADE varchar(120) [not null]
  PRO_BIOGRAFIA varchar(1000) [not null]
  PRO_DEMONSTRACAO boolean [not null, default: false]
  indexes { PRO_NOME }
}
Table VAP_AVALIACAO_REALIZADA {
  ALU_ID bigint [not null, ref: > ALU_ALUNO.ALU_ID]
  PRO_ID bigint [not null, ref: > PRO_PROFESSOR.PRO_ID]
  indexes { (ALU_ID, PRO_ID) [pk] }
  Note: 'Registro legado da V4, preservado; não restringe avaliações novas por treino.'
}
Table AVP_AVALIACAO_PROFESSOR {
  AVP_ID bigint [pk, increment]
  TRN_ID bigint [unique, ref: > VAT_TREINO_AVALIADO.TRN_ID, note: 'NULL apenas nos registros anteriores à V4']
  ALU_ID bigint [not null, ref: > ALU_ALUNO.ALU_ID]
  PRO_ID bigint [not null, ref: > PRO_PROFESSOR.PRO_ID]
  AVP_AUXILIO integer [not null, note: 'CHECK entre 0 e 5']
  AVP_PONTUALIDADE integer [not null, note: 'CHECK entre 0 e 5']
  AVP_POSTURA integer [not null, note: 'CHECK entre 0 e 5']
  AVP_DIDATICA integer [not null, note: 'CHECK entre 0 e 5']
  AVP_ADEQUACAO integer [not null, note: 'CHECK entre 0 e 5; maior é mais adequada']
  AVP_COMENTARIO varchar(500)
  AVP_CRIACAO timestamptz [not null]
  AVP_ATUALIZACAO timestamptz [not null, note: 'CHECK não anterior à criação']
  indexes {
    (PRO_ID, AVP_CRIACAO, AVP_ID)
    (ALU_ID, AVP_CRIACAO, AVP_ID)
  }
}
Table TRN_TREINO {
  TRN_ID bigint [pk, increment]
  ALU_ID bigint [not null, ref: > ALU_ALUNO.ALU_ID]
  PRO_ID bigint [not null, ref: > PRO_PROFESSOR.PRO_ID]
  TRN_DESCRICAO varchar(120) [not null]
  TRN_INICIO timestamptz [not null]
  TRN_TERMINO timestamptz [not null, note: 'CHECK posterior ao início']
  TRN_CONCLUIDO boolean [not null, default: false]
  TRN_DEMONSTRACAO boolean [not null, default: false]
  indexes {
    (TRN_ID, ALU_ID, PRO_ID) [unique]
    (ALU_ID, TRN_CONCLUIDO, TRN_INICIO, TRN_ID)
  }
}
Table VAT_TREINO_AVALIADO {
  TRN_ID bigint [pk, ref: - TRN_TREINO.TRN_ID]
  Note: 'Preserva somente o treino avaliado após excluir o conteúdo; impede recriação naquele treino.'
}
Ref: AVP_AVALIACAO_PROFESSOR.(TRN_ID, ALU_ID, PRO_ID) > TRN_TREINO.(TRN_ID, ALU_ID, PRO_ID)

Table ACD_ACADEMIA {
  ACD_ID bigint [pk, increment]
  ACD_NOME varchar(100) [not null]
}
Table GRT_GRUPO_TREINO {
  GRT_ID bigint [pk, increment]
  GRT_NOME varchar(60) [not null]
  ALU_ORGANIZADOR bigint [not null]
  ACD_ID bigint [not null, ref: > ACD_ACADEMIA.ACD_ID]
  GRT_CRIACAO timestamptz [not null]
  GRT_ENCERRAMENTO timestamptz
  indexes { (GRT_ID, ACD_ID) [unique] }
}
Ref: GRT_GRUPO_TREINO.(ALU_ORGANIZADOR, ACD_ID) > ALU_ALUNO.(ALU_ID, ACD_ID)
Table PGR_PARTICIPACAO_GRUPO {
  PGR_ID bigint [pk, increment]
  GRT_ID bigint [not null]
  ALU_ID bigint [not null]
  ACD_ID bigint [not null]
  PGR_ENTRADA timestamptz [not null]
  PGR_SAIDA timestamptz
  PGR_ATIVO bigint [note: 'Coluna gerada: ALU_ID quando PGR_SAIDA é nula']
  indexes { (GRT_ID, PGR_ATIVO) [unique] (ALU_ID, GRT_ID, PGR_SAIDA) }
}
Ref: PGR_PARTICIPACAO_GRUPO.(GRT_ID, ACD_ID) > GRT_GRUPO_TREINO.(GRT_ID, ACD_ID)
Ref: PGR_PARTICIPACAO_GRUPO.(ALU_ID, ACD_ID) > ALU_ALUNO.(ALU_ID, ACD_ID)
Table CGR_CONVITE_GRUPO {
  CGR_ID bigint [pk, increment]
  GRT_ID bigint [not null]
  ALU_ID bigint [not null]
  ACD_ID bigint [not null]
  CGR_SITUACAO varchar(12) [not null, note: 'PENDENTE, ACEITO, RECUSADO, CANCELADO']
  CGR_ENVIO timestamptz [not null]
  CGR_RESPOSTA timestamptz
  CGR_PENDENTE bigint [note: 'Coluna gerada: ALU_ID quando PENDENTE']
  indexes { (GRT_ID, CGR_PENDENTE) [unique] (ALU_ID, CGR_ENVIO) }
}
Ref: CGR_CONVITE_GRUPO.(GRT_ID, ACD_ID) > GRT_GRUPO_TREINO.(GRT_ID, ACD_ID)
Ref: CGR_CONVITE_GRUPO.(ALU_ID, ACD_ID) > ALU_ALUNO.(ALU_ID, ACD_ID)
Table TGR_TREINO_GRUPO {
  TGR_ID bigint [pk, increment]
  GRT_ID bigint [not null, ref: > GRT_GRUPO_TREINO.GRT_ID]
  TGR_INICIO timestamptz [not null]
  TGR_PRAZO timestamptz [not null, note: 'criação < prazo < início']
  TGR_CRIACAO timestamptz [not null]
  TGR_CANCELAMENTO timestamptz
  indexes { (GRT_ID, TGR_INICIO) TGR_PRAZO }
}
Table CTR_CONVITE_TREINO {
  CTR_ID bigint [pk, increment]
  TGR_ID bigint [not null, ref: > TGR_TREINO_GRUPO.TGR_ID]
  ALU_ID bigint [not null, ref: > ALU_ALUNO.ALU_ID]
  CTR_SITUACAO varchar(12) [not null, note: 'PENDENTE, CONFIRMADO, RECUSADO, EXPIRADO, CANCELADO']
  CTR_CRIACAO timestamptz [not null]
  CTR_RESPOSTA timestamptz
  CTR_CANCELAMENTO timestamptz
  CTR_MOTIVO varchar(30)
  indexes { (TGR_ID, ALU_ID) [unique] (ALU_ID, TGR_ID) (CTR_SITUACAO, TGR_ID) }
}

Table EQP_EQUIPAMENTO {
  EQP_ID bigint [pk, increment]
  EQP_PATRIMONIO varchar(24) [not null, unique]
  EQP_SERIE varchar(40) [unique]
  EQP_NOME varchar(100) [not null]
  EQP_TIPO varchar(20) [not null]
  EQP_MARCA varchar(60) [not null]
  EQP_MODELO varchar(60) [not null]
  EQP_AQUISICAO date [not null]
  EQP_AREA varchar(20) [not null]
  EQP_SITUACAO varchar(20) [not null]
  EQP_PERIODICIDADE integer [not null]
  EQP_ULTIMA_INSPECAO date
}

Table REQ_REGISTRO_EQUIPAMENTO {
  REQ_ID bigint [pk, increment]
  EQP_ID bigint [not null, ref: > EQP_EQUIPAMENTO.EQP_ID]
  REQ_DATA date [not null]
  REQ_RESPONSAVEL varchar(100) [not null]
  REQ_AREA_ANTERIOR varchar(20) [not null]
  REQ_AREA_NOVA varchar(20) [not null]
  REQ_SITUACAO_ANTERIOR varchar(20) [not null]
  REQ_SITUACAO_NOVA varchar(20) [not null]
  REQ_RESULTADO varchar(24)
  REQ_OBSERVACAO varchar(800)
}

Table PEQ_PROBLEMA_EQUIPAMENTO {
  PEQ_ID bigint [pk, increment]
  EQP_ID bigint [not null, ref: > EQP_EQUIPAMENTO.EQP_ID]
  PEQ_TITULO varchar(100) [not null]
  PEQ_RELATO varchar(800) [not null]
  PEQ_GRAVIDADE varchar(10) [not null]
  PEQ_RISCO boolean [not null]
  PEQ_EVIDENCIA varchar(180)
  PEQ_DATA_RELATO date [not null]
  PEQ_RESPONSAVEL varchar(100) [not null]
  PEQ_SITUACAO varchar(12) [not null]
  PEQ_DATA_ENCERRAMENTO date
  PEQ_DESFECHO varchar(800)
}

Table OMT_ORDEM_MANUTENCAO {
  OMT_ID bigint [pk, increment]
  PEQ_ID bigint [not null, ref: > PEQ_PROBLEMA_EQUIPAMENTO.PEQ_ID]
  OMT_TECNICO varchar(100) [not null]
  OMT_DIAGNOSTICO varchar(800) [not null]
  OMT_ABERTURA date [not null]
  OMT_RESPONSAVEL varchar(100) [not null]
  OMT_SITUACAO varchar(12) [not null]
  OMT_INICIO date
  OMT_TERMINO date
  OMT_CUSTO_ESTIMADO decimal(12,2)
  OMT_CUSTO_REAL decimal(12,2)
  OMT_SERVICO_EXECUTADO varchar(800)
  OMT_JUSTIFICATIVA varchar(800)
  OMT_PROBLEMA_ATIVO bigint [unique, note: 'PEQ_ID quando aberta ou em andamento']
}
